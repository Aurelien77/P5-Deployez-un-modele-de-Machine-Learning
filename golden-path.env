# =============================================================================
# GOLDEN PATH — interrupteurs du pipeline principal
# =============================================================================
# Fichier à la RACINE du dépôt.
# C'est LUI qui active ou désactive les jobs de .github/workflows/ci-cd.yml
#
# Valeurs acceptées : true  |  false
#
# Après modification :
#   git add golden-path.env
#   git commit -m "chore: ajuster le golden path"
#   git push origin Stagging    # si ENABLE_STAGING_TESTS=true
#   git push origin Main        # si ENABLE_PRODUCTION_RELEASE=true
# =============================================================================

# Chemin 1 — push sur Stagging → job "Tests" du pipeline ci-cd
ENABLE_STAGING_TESTS=true

# Chemin 2 — push sur Main → jobs "Build images" + "Release production"
# Le déploiement reste bloqué tant qu'un reviewer n'a pas validé
# l'environnement GitHub "production".
ENABLE_PRODUCTION_RELEASE=true

# Tags + versions (semantic-release) — UNIQUEMENT sur Stagging
# Produit un tag vX.Y.Z-rc.N et un artefact Actions "release-version".
# Main récupère cet artefact pour taguer les images.
ENABLE_SEMANTIC_RELEASE=true
